{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": [
      "node",
      "svelte",
      "vite/client"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/testing/*.ts",
    "src/**/*.d.ts",
    "src/**/tests/**/*.ts"
  ]
}
